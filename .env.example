# Copy to .env.local. Everything here has a free option.

# --- Text AI (free): get a key at https://aistudio.google.com ---
GEMINI_API_KEY=
# Model ids get deprecated; change this if the default stops working.
# GEMINI_MODEL=gemini-2.5-flash

# Or use any OpenAI-compatible endpoint (Groq, OpenRouter, local Ollama):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=
# LLM_API_KEY=

# --- GitHub (free): raises the limit from 60 to 5000 requests/hour ---
# Create a token with NO scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Try the app without any keys or network ---
# MOCK_AI=1

# --- Optional avatar providers (OFF until you set these; may cost money) ---
# DID_API_KEY=
# HEYGEN_API_KEY=
# HEYGEN_VOICE_ID=
